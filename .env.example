# Admin access (required to enable /admin). Use a long random password.
ADMIN_PASSWORD=
# 32+ random characters used to sign admin sessions: `openssl rand -hex 32`
SESSION_SECRET=
# Shared code given privately to classmates so they can submit memories.
CONTRIBUTOR_CODE=
# Where the file-based archive store and uploads live (default: ./.data)
DATA_DIR=
# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
